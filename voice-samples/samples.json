{
 "lines": [
  {
   "id": "welcome_01",
   "text": "जय बाबा की, आज कित जाणा सै?"
  },
  {
   "id": "welcome_02",
   "text": "जय बाबा की भाई, आज कित का प्लान सै?"
  },
  {
   "id": "welcome_04",
   "text": "जय बाबा की ताई आले, आज कित की तैयारी सै?"
  },
  {
   "id": "welcome_05",
   "text": "जय बाबा की भाई! गाड्डी त्यार सै, बोल कित चालां?"
  },
  {
   "id": "welcome_09",
   "text": "जय बाबा की! गाड्डी भी जाग गी अर मैं भी, बोल कित का गेड़ा सै?"
  },
  {
   "id": "welcome_15",
   "text": "जय बाबा की! ट्रैक्टर जिसा दम, अर मेरे जिसी बोली, चाल पड़ां?"
  },
  {
   "id": "welcome_16_m",
   "text": "जय बाबा की! आज रास्ता मैं बताऊंगा, तू बस मौज तै चला।"
  },
  {
   "id": "welcome_morning_02",
   "text": "सवेरे सवेरे जय बाबा की! चाय पी ली के?"
  },
  {
   "id": "welcome_evening_04",
   "text": "साँझ हो गी, जय बाबा की!"
  },
  {
   "id": "farewell_03",
   "text": "जय बाबा की भाई, आराम कर ले, फेर मिलांगे।"
  },
  {
   "id": "farewell_05",
   "text": "आज का सफर बढ़िया रया, जय बाबा की!"
  },
  {
   "id": "farewell_07",
   "text": "जय बाबा की! आज का गेड़ा कसूत रया, फेर मिलांगे।"
  },
  {
   "id": "greeting_01",
   "text": "जय बाबा की भाई! कित चालणा सै आज?"
  },
  {
   "id": "greeting_03",
   "text": "जय बाबा की! बेल्ट ला ले, फेर चालांगे।"
  },
  {
   "id": "greeting_05",
   "text": "जय बाबा की! गाड्डी भी रेडी, मैं भी रेडी।"
  },
  {
   "id": "cancelled_03",
   "text": "जय बाबा की, मैं उरे ए सूं।"
  },
  {
   "id": "talk_joke_02",
   "text": "मन्नै ताऊ तै पूछ्या, हॉर्न क्यूं बजाया? बोल्या, भैंस नै जय बाबा की करी थी!"
  },
  {
   "id": "toll_paid_plain_08",
   "text": "टोल आळे भाई नै जय बाबा की, पीस्से फास्टैग तै कट गे।"
  },
  {
   "id": "police_ahead_06",
   "text": "आग्गै चेकिंग सै, स्पीड कम, पुलिस आळे भाइयां नै जय बाबा की करदे जाइए।"
  },
  {
   "id": "mobile_camera_ahead_05",
   "text": "आग्गै स्पीड गन सै, लिमिट मैं चाल, पुलिस आळे भाइयां नै जय बाबा की।"
  }
 ],
