    {"id": "rerouting_01", "event": "Rerouting", "group": "Navigation", "text": "रास्ता भटक गया भाई, नया रास्ता देख रया सूं।", "hash": "38cb4023f69d"},
    {"id": "rerouting_02", "event": "Rerouting", "group": "Navigation", "text": "कोए बात ना, दूसरा रास्ता काढूं सूं।", "hash": "204927fcb057"},
