    {"id": "welcome_01", "event": "Welcome", "group": "Welcome", "text": "राम राम जी, आज कित जाणा सै?", "hash": "087ffcdb4254"},
    {"id": "welcome_02", "event": "Welcome", "group": "Welcome", "text": "राम राम भाई, आज कित का प्लान सै?", "hash": "2d75a86dcf53"},
    {"id": "welcome_03", "event": "Welcome", "group": "Welcome", "text": "और तैयारे? सुणा दे, के हाल सै?", "hash": "6975f0542d9b"},
    {"id": "welcome_04", "event": "Welcome", "group": "Welcome", "text": "राम राम ताई आले, आज कित की तैयारी सै?", "hash": "a635fa0222a8"},
    {"id": "welcome_05", "event": "Welcome", "group": "Welcome", "text": "राम राम भाई! गाड्डी त्यार सै, बोल कित चालां?", "hash": "c84d0c34e6d2"},
    {"id": "welcome_06", "event": "Welcome", "group": "Welcome", "text": "भाई कित जाणा सै आज?", "hash": "b506a78d792d"},
    {"id": "welcome_07", "event": "Welcome", "group": "Welcome", "text": "आज कित की तैयारी सै?", "hash": "959f880a2e5f"},
    {"id": "welcome_08", "event": "Welcome", "group": "Welcome", "text": "आज कित का प्लान बणैगा?", "hash": "db9a0ecc0811"},
    {"id": "welcome_morning_01", "event": "WelcomeMorning", "group": "Welcome", "text": "सवेरे सवेरे कित चाल पड़े ताऊ?", "hash": "744c8063f00a"},
    {"id": "welcome_morning_02", "event": "WelcomeMorning", "group": "Welcome", "text": "सवेरे की राम राम! चाय पी ली के?", "hash": "267ffe8cdb21"},
    {"id": "welcome_morning_03", "event": "WelcomeMorning", "group": "Welcome", "text": "सवेरे सवेरे सड़क खाली सै, फेर भी धीरे चलाइए।", "hash": "93eb95ef8c02"},
    {"id": "welcome_morning_04", "event": "WelcomeMorning", "group": "Welcome", "text": "दिन की शुरुआत बढ़िया हो, चाल पड़ां।", "hash": "c590a11bd98e"},
    {"id": "welcome_afternoon_01", "event": "WelcomeAfternoon", "group": "Welcome", "text": "दोपहर हो री सै, धूप तै बच कै चलाइए।", "hash": "e041af9ab817"},
    {"id": "welcome_afternoon_02", "event": "WelcomeAfternoon", "group": "Welcome", "text": "रोटी खा ली के भाई? फेर चालां।", "hash": "8f6ac85fbc7e"},
    {"id": "welcome_afternoon_03", "event": "WelcomeAfternoon", "group": "Welcome", "text": "दोपहर मैं नींद आवै तो बता दिए, रुक ल्यांगे।", "hash": "be47110e7d03"},
    {"id": "welcome_afternoon_04", "event": "WelcomeAfternoon", "group": "Welcome", "text": "घाम घणा सै, AC चला ले अर पाणी पी ले।", "hash": "e03d75320f9d"},
    {"id": "welcome_evening_01", "event": "WelcomeEvening", "group": "Welcome", "text": "साँझ हो ली, बत्ती जला ले भाई।", "hash": "0ce757675746"},
    {"id": "welcome_evening_02", "event": "WelcomeEvening", "group": "Welcome", "text": "साँझ का टैम सै, सड़क पै भीड़ होगी, आराम तै चलाइए।", "hash": "4b55a3841605"},
    {"id": "welcome_evening_03", "event": "WelcomeEvening", "group": "Welcome", "text": "काम निपट ग्या के? चाल घरां चालां।", "hash": "bc4a8efbd98e"},
    {"id": "welcome_evening_04", "event": "WelcomeEvening", "group": "Welcome", "text": "साँझ की राम राम जी!", "hash": "3837358ecb83"},
    {"id": "welcome_night_01", "event": "WelcomeNight", "group": "Welcome", "text": "रात हो री सै, आराम तै चलाइए।", "hash": "8e2138f8716b"},
    {"id": "welcome_night_02", "event": "WelcomeNight", "group": "Welcome", "text": "रात नै हेडलाइट ठीक राखिए, अर नींद आवै तो रुक जाइए।", "hash": "a00c308200df"},
    {"id": "welcome_night_03", "event": "WelcomeNight", "group": "Welcome", "text": "इतणी रात नै कित चाल पड़े भाई? ध्यान तै।", "hash": "7be570f64264"},
    {"id": "welcome_night_04", "event": "WelcomeNight", "group": "Welcome", "text": "रात का सफर सै, मैं जाग्गूं सूं, तू भी जाग्या रहिए।", "hash": "fa6f7b73c3ea"},
    {"id": "farewell_01", "event": "Farewell", "group": "Welcome", "text": "चाल फेर मिलांगे।", "hash": "16b2ddd80db5"},
    {"id": "farewell_02", "event": "Farewell", "group": "Welcome", "text": "गाड्डी ढंग तै लॉक कर दिए।", "hash": "9527ab88feab"},
    {"id": "farewell_03", "event": "Farewell", "group": "Welcome", "text": "राम राम भाई, आराम कर ले, फेर मिलांगे।", "hash": "2d9250863d42"},
    {"id": "farewell_04", "event": "Farewell", "group": "Welcome", "text": "पहुँच गे, शीशे चढ़ा ले अर गाड्डी लॉक कर दिए।", "hash": "099c3accbf4a"},
    {"id": "farewell_05", "event": "Farewell", "group": "Welcome", "text": "आज का सफर बढ़िया रया, राम राम!", "hash": "02b92fce4b47"},
    {"id": "greeting_01", "event": "Greeting", "group": "Voice", "text": "राम राम भाई! कित चालणा सै आज?", "hash": "4a4d89dd6c0a"},
    {"id": "greeting_02", "event": "Greeting", "group": "Voice", "text": "सुणा ताई आळे, गाड्डी त्यार सै!", "hash": "7c950d4949a2"},
    {"id": "greeting_03", "event": "Greeting", "group": "Voice", "text": "राम राम! बेल्ट ला ले, फेर चालांगे।", "hash": "c0737634e94d"},
    {"id": "greeting_04", "event": "Greeting", "group": "Voice", "text": "आ ग्या भाई? चाल, आज कित की सैर करणी सै?", "hash": "fbdee68b382c"},
    {"id": "greeting_05", "event": "Greeting", "group": "Voice", "text": "राम राम जी! गाड्डी भी रेडी, मैं भी रेडी।", "hash": "f63d7b5cec25"},
    {"id": "greeting_06", "event": "Greeting", "group": "Voice", "text": "भाई कैसा सै, सब राजी खुशी? परिवार में सब ठीक?", "hash": "51f744f489e0"},
    {"id": "wake_reply_01", "event": "WakeReply", "group": "Voice", "text": "हाँ भाई, बोल।", "hash": "fb9d3982a053"},
    {"id": "wake_reply_02", "event": "WakeReply", "group": "Voice", "text": "हाँ जी, सुण रया सूं।", "hash": "5f63761d682c"},
    {"id": "wake_reply_03", "event": "WakeReply", "group": "Voice", "text": "बोल ताऊ, के सेवा करूं?", "hash": "cc9c90e1514e"},
    {"id": "wake_reply_04", "event": "WakeReply", "group": "Voice", "text": "हाँ, बता के करणा सै?", "hash": "5cc6774ed44d"},
    {"id": "ask_destination_01", "event": "AskDestination", "group": "Voice", "text": "कित चालणा सै?", "hash": "d5da1ce412da"},
    {"id": "ask_destination_02", "event": "AskDestination", "group": "Voice", "text": "बता भाई, कित ले चालूं?", "hash": "8f93042081da"},
    {"id": "ask_destination_03", "event": "AskDestination", "group": "Voice", "text": "हां जी, कड़े जाणा सै?", "hash": "3e477ecb21be"},
    {"id": "ask_destination_04", "event": "AskDestination", "group": "Voice", "text": "बोल, कित का रास्ता दिखाऊं?", "hash": "866a1ad33e6a"},
    {"id": "ask_destination_05", "event": "AskDestination", "group": "Voice", "text": "बोल भाई, आज कित का प्लान सै?", "hash": "166244c4f2ba"},
    {"id": "command_done_01", "event": "CommandDone", "group": "Voice", "text": "ठीक सै, कर दिया।", "hash": "6f3694b244c4"},
