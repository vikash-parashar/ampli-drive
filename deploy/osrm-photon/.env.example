# Copy to .env and fill in. DNS A records for both hosts must point at the instance's Elastic IP.
ROUTE_HOST=route.ampliapps.in
GEO_HOST=geo.ampliapps.in
ACME_EMAIL=you@example.com

# Optional overrides
OSRM_VERSION=v5.27.1
PHOTON_VERSION=0.7.0
OSRM_MEM_LIMIT=9g
PHOTON_MEM_LIMIT=5g
PHOTON_JAVA_OPTS=-Xms1g -Xmx3g
# Photon India dump (check the current URL on https://github.com/komoot/photon#installation)
PHOTON_DUMP_URL=https://download1.graphhopper.com/public/extracts/by-country-code/in/photon-db-in-latest.tar.bz2
