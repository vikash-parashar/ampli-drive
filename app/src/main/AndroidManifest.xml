<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- GPS speedometer, glance map and day/night from sun position. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Map tiles (OpenFreeMap). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Quick controls: Wi-Fi on/off and the connected network's name (normal permission). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Connected phone name in the status row; OBD-II dongle (Bluetooth SPP). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Android 8 to 11 (many head units): legacy install-time Bluetooth permissions. There, a BLE
         tyre-sensor scan also needs ACCESS_FINE_LOCATION (above). See system/BtPermissions.kt. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- BLE tyre-pressure sensors. Asked for only when Tyres is first opened. Never used for location. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <!-- "Hey Ampli": wake word and voice commands. The wake word runs offline in a
         microphone foreground service, only while the driver has switched it on. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Drive monitor: break timer, odometer, crash detection and parking spot while Maps is in front. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional floating speed bubble over Google Maps. Asked for only when the driver switches
         the bubble on in Settings › Car. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- "Play <song> from my storage" (MediaStore, USB and SD included). -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Boot only marks "the car started" (greeting, Settings › When the car starts); the actions run
         when the launcher shows. The wake-word microphone service is still never started from boot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The head unit has GPS but may lack some of these; none are required to install. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Package visibility (Android 11+): apps the launcher lists or opens. -->
    <queries>
        <!-- All-apps grid. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Phone button. -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <!-- Music button: the default music app, and apps that play audio files. (The MAIN/LAUNCHER
             query above already makes every launchable app visible, so the head unit's own
             "Multimedia", "BT music" and "BT phone" apps can be matched by label. No
             QUERY_ALL_PACKAGES needed.) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MUSIC" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:mimeType="audio/*" />
        </intent>
        <!-- Navigate fallback when Google Maps is missing. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="google.navigation" />
        </intent>
        <!-- Help panel: helplines open in the dialer (no CALL_PHONE). -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <!-- SOS: SMS composer and share sheet (no SEND_SMS). -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- FASTag recharge page. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- Voice: speech recognition and text-to-speech engines. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Voice: "play <song>" in a music player. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="audio/*" />
        </intent>
        <intent>
            <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
        </intent>
        <package android:name="com.google.android.apps.maps" />
        <!-- Papers: "Open DigiLocker". -->
        <package android:name="com.digilocker.android" />
        <package android:name="com.vikash.ampli" />
        <package android:name="com.syu.bt" />
        <!-- Android Auto and head-unit phone-link apps ("connect my phone"). -->
        <package android:name="com.google.android.projection.gearhead" />
        <package android:name="com.zjinnova.zlink" />
        <package android:name="com.suding.speedplay" />
        <package android:name="com.autokit" />
        <package android:name="com.autokit.app" />
        <package android:name="net.easyconn" />
        <package android:name="net.easyconn.carman.wws" />
        <package android:name="com.carlinkit" />
        <package android:name="com.carbit.phonelink" />
        <package android:name="com.syu.carlink" />
        <package android:name="com.fyt.phonelink" />
        <package android:name="com.ts.phonelink" />
        <package android:name="com.tw.carplay" />
        <package android:name="com.ex.phonelink" />
        <package android:name="cn.manstep.phonemirrorBox" />
        <!-- Quick controls › Equalizer: head-unit vendors' EQ apps (system/Shell.kt EQ_PACKAGES). -->
        <package android:name="com.syu.eq" />
        <package android:name="com.syu.audio" />
        <package android:name="com.fyt.eq" />
        <package android:name="com.ts.eq" />
        <package android:name="com.ts.dsp" />
        <package android:name="com.tw.eq" />
        <package android:name="com.microntek.eq" />
        <package android:name="com.microntek.audio" />
        <package android:name="com.mtc.eq" />
        <package android:name="com.android.eq" />
        <package android:name="com.yf.eq" />
        <package android:name="com.hzbhd.eq" />
        <package android:name="com.autochips.eq" />
        <intent>
            <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
        </intent>
    </queries>

    <application
        android:name=".DriveApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:largeHeap="false"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.AmpliDrive">

        <!-- The home screen. HOME + DEFAULT lets Android offer it as the default home app. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:stateNotNeeded="true"
            android:resizeableActivity="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Steering-wheel / hardware voice key while another app is in front: Android turns that
             key into one of these intents. Transparent; it stays only while "Hey Ampli" talks. -->
        <activity
            android:name=".VoiceKeyActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <action android:name="android.intent.action.VOICE_ASSIST" />
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <action android:name="android.intent.action.SEARCH_LONG_PRESS" />
                <action android:name="android.speech.action.WEB_SEARCH" />
                <action android:name="android.speech.action.VOICE_SEARCH_HANDS_FREE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Reads media sessions (any player), the Google Maps navigation notification and
             FASTag toll SMS notifications (no READ_SMS permission). -->
        <service
            android:name=".service.DriveNotificationListener"
            android:exported="true"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Boot: marks the car start as pending (see car/CarStart.kt). -->
        <receiver
            android:name=".car.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- "Hey Ampli" wake word (Vosk, offline). Started only from the visible launcher. -->
        <service
            android:name=".voice.VoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Background alerts (location): speed cameras, break timer, crash detection, parking spot and
             the speed bubble while Google Maps is in front. Started only from the visible launcher,
             after the in-app location disclosure; off in Settings › Car. -->
        <service
            android:name=".car.CarMonitorService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Expenses › Export CSV: shares a file from the cache folder. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
