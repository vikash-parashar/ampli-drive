<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- GPS speedometer, glance map and day/night from sun position. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Map tiles (OpenFreeMap). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Connected phone name in the status row; OBD-II dongle (Bluetooth SPP). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- BLE tyre-pressure sensors. Asked for only when Tyres is first opened. Never used for location. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <!-- "Hey Ampli": wake word and voice commands. The wake word runs offline in a
         microphone foreground service, only while the driver has switched it on. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Drive monitor: break timer, odometer, crash detection and parking spot while Maps is in front. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "Play <song> from my storage" (MediaStore, USB and SD included). -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- No RECEIVE_BOOT_COMPLETED: a microphone service can't start from boot (see VoiceService). -->

    <!-- The head unit has GPS but may lack some of these; none are required to install. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Package visibility (Android 11+): apps the launcher lists or opens. -->
    <queries>
        <!-- All-apps grid. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Phone button. -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <!-- Navigate fallback when Google Maps is missing. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="google.navigation" />
        </intent>
        <!-- Help panel: helplines open in the dialer (no CALL_PHONE). -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <!-- SOS: SMS composer and share sheet (no SEND_SMS). -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- FASTag recharge page. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- Voice: speech recognition and text-to-speech engines. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Voice: "play <song>" in a music player. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="audio/*" />
        </intent>
        <intent>
            <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
        </intent>
        <package android:name="com.google.android.apps.maps" />
        <!-- Papers: "Open DigiLocker". -->
        <package android:name="com.digilocker.android" />
        <package android:name="com.vikash.ampli" />
        <package android:name="com.syu.bt" />
        <!-- Android Auto and head-unit phone-link apps ("connect my phone"). -->
        <package android:name="com.google.android.projection.gearhead" />
        <package android:name="com.zjinnova.zlink" />
        <package android:name="com.suding.speedplay" />
        <package android:name="com.autokit" />
        <package android:name="com.autokit.app" />
        <package android:name="net.easyconn" />
        <package android:name="net.easyconn.carman.wws" />
        <package android:name="com.carlinkit" />
        <package android:name="com.carbit.phonelink" />
        <package android:name="com.syu.carlink" />
        <package android:name="com.fyt.phonelink" />
        <package android:name="com.ts.phonelink" />
        <package android:name="com.tw.carplay" />
        <package android:name="com.ex.phonelink" />
    </queries>

    <application
        android:name=".DriveApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:largeHeap="false"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.AmpliDrive">

        <!-- The home screen. HOME + DEFAULT lets Android offer it as the default home app. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:stateNotNeeded="true"
            android:resizeableActivity="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reads media sessions (any player), the Google Maps navigation notification and
             FASTag toll SMS notifications (no READ_SMS permission). -->
        <service
            android:name=".service.DriveNotificationListener"
            android:exported="true"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- "Hey Ampli" wake word (Vosk, offline). Started only from the visible launcher. -->
        <service
            android:name=".voice.VoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Drive monitor (location). Started only from the visible launcher; off in Settings › Car. -->
        <service
            android:name=".car.CarMonitorService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Expenses › Export CSV: shares a file from the cache folder. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
