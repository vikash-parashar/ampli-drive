    <!-- WhatsApp card: Telegram and voice replies. -->
    <string name="chat_telegram_title">Telegram messages too</string>
    <string name="chat_telegram_hint">Read Telegram messages the same way.</string>
    <string name="chat_reply_title">Reply by voice</string>
    <string name="chat_reply_hint">After a message, say your reply. It is read back before it is sent.</string>
    <string name="chat_reply_rules">A reply goes only after you hear it read back and say “haan, bhej de”. It is sent by WhatsApp or Telegram through their own reply button; Car Hub uploads nothing.</string>
    <string name="disclosure_chat2_title">Telegram and voice replies</string>
    <string name="disclosure_chat2_body">To read Telegram messages aloud and to send replies you speak, Car Hub reads the sender\'s name and the message text from WhatsApp and Telegram notifications and uses the notification\'s own reply button. It uses notification access and the microphone to do this.</string>
    <string name="disclosure_chat2_uses">A reply is sent only after you say it, hear it read back and say “haan, bhej de”. Your spoken reply is turned into text by your device\'s speech recognition service (for example Google\'s), then handed to WhatsApp or Telegram, which send it. Messages are never shown on the driving screen and never saved.</string>
    <string name="disclosure_chat2_stays">Car Hub stores and uploads nothing, and shares nothing with Ampli Studio or anyone else.</string>

