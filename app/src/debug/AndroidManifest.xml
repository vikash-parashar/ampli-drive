<?xml version="1.0" encoding="utf-8"?>
<!-- Test APKs only (debug build type, the CI test build). The Play bundle is a release build and
     never declares this: there, Ampli MP3 Player comes from Play. See system/Mp3Install.kt. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- "Get Ampli MP3 Player" › Download and install: opens the system installer for the APK
         downloaded from the player's public GitHub releases. Android still asks the driver. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
